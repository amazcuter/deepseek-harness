# Copy to production.env and configure the production service before selecting this preset.
MWF_DESKTOP_APP_ID=com.deepseek.harness
MWF_DESKTOP_AUTO_UPDATE_ENV=production
MWF_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
MWF_DESKTOP_MACOS_PACK_CONCURRENCY=4
MWF_DESKTOP_MACOS_DOWNLOAD_PROXY=
MWF_DESKTOP_MACOS_NOTARIZATION_PROXY=
