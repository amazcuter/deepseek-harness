{
  "name": "@metaworkflow/tool-todo",
  "description": "Model-facing todo_write tool over the DeepSeek Harness event-sourced session log",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/todo/tool-todo"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-loop": "workspace:*",
    "@metaworkflow/agent-loop-testkit": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@metaworkflow/user-questions": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
