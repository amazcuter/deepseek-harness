{
  "name": "@metaworkflow/acp",
  "description": "Automation-only Agent Client Protocol server for driving DeepSeek Harness agents over JSON-RPC stdio",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@metaworkflow/brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/mcp-client": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-persistence": "workspace:*",
    "@metaworkflow/token-meter": "workspace:*",
    "@metaworkflow/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@metaworkflow/token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-loop": "workspace:*",
    "@metaworkflow/agent-loop-testkit": "workspace:*",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/mcp-client": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-persistence": "workspace:*",
    "@metaworkflow/session-persistence-jsonl": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/token-meter": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@metaworkflow/user-approval": "workspace:*"
  }
}
