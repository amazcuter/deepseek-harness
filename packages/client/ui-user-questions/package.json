{
  "name": "@metaworkflow/client-ui-user-questions",
  "description": "Web ask_user_question composer takeover and plan-review presentation UI",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mwf": {
    "client": {
      "inject": [
        "@metaworkflow/api-remotes",
        "@metaworkflow/api-session-controller",
        "@metaworkflow/client-locale",
        "@metaworkflow/client-ui-conversation",
        "@metaworkflow/client-ui-renderer",
        "@metaworkflow/client-ui-session",
        "@metaworkflow/client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/api-remotes": "workspace:*",
    "@metaworkflow/api-session-controller": "workspace:*",
    "@metaworkflow/brand": "workspace:*",
    "@metaworkflow/client-locale": "workspace:*",
    "@metaworkflow/client-store": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@metaworkflow/user-questions": "workspace:*",
    "@metaworkflow/client-ui-primitives": "workspace:*",
    "@metaworkflow/client-ui-slots": "workspace:*",
    "@metaworkflow/client-ui-renderer": "workspace:*",
    "@metaworkflow/client-ui-session": "workspace:*",
    "@metaworkflow/typert-protocol": "workspace:*",
    "react": "^18.2.0",
    "@metaworkflow/client-ui-conversation": "workspace:*",
    "@metaworkflow/client-connection": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "clsx": "^2.0.0",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/client-ui-chat": "workspace:*",
    "@metaworkflow/client-ui-tool": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
