{
  "name": "@metaworkflow/client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mwf": {
    "client": {
      "inject": [
        "@metaworkflow/api-workspace-controller",
        "@metaworkflow/client-connection",
        "@metaworkflow/client-locale",
        "@metaworkflow/client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@metaworkflow/spill-policy": "workspace:*",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@metaworkflow/tool-jobs": "workspace:*",
    "@metaworkflow/tool-session-query": "workspace:*",
    "@metaworkflow/tool-terminal": "workspace:*",
    "@metaworkflow/spill": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/api-remotes": "workspace:*",
    "@metaworkflow/client-connection": "workspace:*",
    "@metaworkflow/client-locale": "workspace:*",
    "@metaworkflow/client-test-runtime": "workspace:*",
    "@metaworkflow/client-ui-conversation": "workspace:*",
    "@metaworkflow/client-ui-primitives": "workspace:*",
    "@metaworkflow/client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@metaworkflow/api-workspace-controller": "workspace:*",
    "@metaworkflow/client-ui-chat": "workspace:*",
    "@metaworkflow/client-ui-renderer": "workspace:*",
    "@metaworkflow/client-ui-session": "workspace:*",
    "@metaworkflow/util-values": "workspace:*",
    "@metaworkflow/util-workspace-path": "workspace:*",
    "@metaworkflow/attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@metaworkflow/ptc-runtime": "workspace:*",
    "@metaworkflow/token-meter": "workspace:*",
    "@metaworkflow/user-questions": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
