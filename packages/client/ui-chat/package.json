{
  "name": "@metaworkflow/client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mwf": {
    "client": {
      "inject": [
        "@metaworkflow/api-session-controller",
        "@metaworkflow/api-workspace-controller",
        "@metaworkflow/client-locale",
        "@metaworkflow/client-ui-conversation",
        "@metaworkflow/client-ui-input-trigger",
        "@metaworkflow/client-ui-layout",
        "@metaworkflow/client-ui-renderer",
        "@metaworkflow/client-ui-session",
        "@metaworkflow/client-ui-settings",
        "@metaworkflow/client-ui-sidebar-right",
        "@metaworkflow/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/api-remotes": "workspace:*",
    "@metaworkflow/api-session-controller": "workspace:*",
    "@metaworkflow/api-workspace-controller": "workspace:*",
    "@metaworkflow/api-workspace-files": "workspace:*",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/brand": "workspace:*",
    "@metaworkflow/client-locale": "workspace:*",
    "@metaworkflow/client-store": "workspace:*",
    "@metaworkflow/client-ui-approval": "workspace:*",
    "@metaworkflow/client-ui-conversation": "workspace:*",
    "@metaworkflow/client-ui-input-trigger": "workspace:*",
    "@metaworkflow/client-ui-layout": "workspace:*",
    "@metaworkflow/client-ui-primitives": "workspace:*",
    "@metaworkflow/client-ui-renderer": "workspace:*",
    "@metaworkflow/client-ui-session": "workspace:*",
    "@metaworkflow/client-ui-settings": "workspace:*",
    "@metaworkflow/client-ui-sidebar-browser": "workspace:*",
    "@metaworkflow/client-ui-sidebar-documentpreview": "workspace:*",
    "@metaworkflow/client-ui-sidebar-right": "workspace:*",
    "@metaworkflow/client-ui-slots": "workspace:*",
    "@metaworkflow/client-ui-workspace": "workspace:*",
    "@metaworkflow/commands": "workspace:*",
    "@metaworkflow/compaction": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/llm-retry": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-stats": "workspace:*",
    "@metaworkflow/session-turn-outline": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/token-meter": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@metaworkflow/util-workspace-path": "workspace:*",
    "@metaworkflow/util-values": "workspace:*",
    "@tanstack/react-virtual": "3.14.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@metaworkflow/settings": "workspace:*",
    "@metaworkflow/client-product-analytics": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
