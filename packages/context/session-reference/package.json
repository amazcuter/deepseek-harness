{
  "name": "@metaworkflow/session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@metaworkflow/brand": "workspace:*",
    "@metaworkflow/util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/compaction": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/output-retention": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/session-projection-cache": "workspace:*",
    "@metaworkflow/session-query": "workspace:*",
    "@metaworkflow/session-title": "workspace:*",
    "@metaworkflow/spill": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@metaworkflow/spill": {
      "optional": true
    },
    "@metaworkflow/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/compaction": "workspace:*",
    "@metaworkflow/fs-local": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/output-retention": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/session-projection-cache": "workspace:*",
    "@metaworkflow/session-query": "workspace:*",
    "@metaworkflow/session-query-sqlite": "workspace:*",
    "@metaworkflow/session-title": "workspace:*",
    "@metaworkflow/spill": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/spill-local": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/tool-fs": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@metaworkflow/typert-protocol": "workspace:*",
    "@metaworkflow/working-directory": "workspace:*"
  }
}
