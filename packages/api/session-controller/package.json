{
  "name": "@metaworkflow/api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mwf": {
    "client": {
      "external": [
        "@metaworkflow/api-gateway/client"
      ],
      "inject": [
        "@metaworkflow/api-gateway",
        "@metaworkflow/client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@metaworkflow/brand": "workspace:*",
    "@metaworkflow/deque": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "mime-types": "^3.0.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-default-model": "workspace:*",
    "@metaworkflow/agent-preset-registry": "workspace:*",
    "@metaworkflow/api-gateway": "workspace:*",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/client-connection": "workspace:*",
    "@metaworkflow/client-file-upload": "workspace:*",
    "@metaworkflow/commands": "workspace:*",
    "@metaworkflow/credentials": "workspace:*",
    "@metaworkflow/file-reference": "workspace:*",
    "@metaworkflow/fs": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/native-command": "workspace:*",
    "@metaworkflow/scope": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-persistence": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/session-projection-cache": "workspace:*",
    "@metaworkflow/session-query": "workspace:*",
    "@metaworkflow/session-title": "workspace:*",
    "@metaworkflow/settings": "workspace:*",
    "@metaworkflow/skill": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/typert-protocol": "workspace:*",
    "@metaworkflow/typert-registry": "workspace:*",
    "@metaworkflow/util-time": "workspace:*",
    "@metaworkflow/util-values": "workspace:*",
    "@metaworkflow/util-workspace-path": "workspace:*",
    "@metaworkflow/workspace": "workspace:*",
    "@metaworkflow/working-directory": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@metaworkflow/session-persistence": {
      "optional": true
    },
    "@metaworkflow/session-projection-cache": {
      "optional": true
    },
    "@metaworkflow/settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@metaworkflow/api-remote-access": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-default-model": "workspace:*",
    "@metaworkflow/agent-loop": "workspace:*",
    "@metaworkflow/agent-loop-testkit": "workspace:*",
    "@metaworkflow/agent-preset-registry": "workspace:*",
    "@metaworkflow/api-gateway": "workspace:*",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/client-connection": "workspace:*",
    "@metaworkflow/client-file-upload": "workspace:*",
    "@metaworkflow/client-store": "workspace:*",
    "@metaworkflow/client-test-runtime": "workspace:*",
    "@metaworkflow/commands": "workspace:*",
    "@metaworkflow/credentials": "workspace:*",
    "@metaworkflow/file-reference": "workspace:*",
    "@metaworkflow/fs": "workspace:*",
    "@metaworkflow/fs-local": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/native-command": "workspace:*",
    "@metaworkflow/permission-presets": "workspace:*",
    "@metaworkflow/remote-mock": "workspace:*",
    "@metaworkflow/scope": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-persistence": "workspace:*",
    "@metaworkflow/session-persistence-jsonl": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/session-projection-cache": "workspace:*",
    "@metaworkflow/session-query": "workspace:*",
    "@metaworkflow/session-title": "workspace:*",
    "@metaworkflow/settings": "workspace:*",
    "@metaworkflow/skill": "workspace:*",
    "@metaworkflow/storage": "workspace:*",
    "@metaworkflow/storage-domain": "workspace:*",
    "@metaworkflow/storage-json": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/typert-protocol": "workspace:*",
    "@metaworkflow/typert-registry": "workspace:*",
    "@metaworkflow/util-crypto": "workspace:*",
    "@metaworkflow/util-time": "workspace:*",
    "@metaworkflow/util-values": "workspace:*",
    "@metaworkflow/util-workspace-path": "workspace:*",
    "@metaworkflow/workspace": "workspace:*",
    "@types/mime-types": "^3.0.1",
    "@metaworkflow/working-directory": "workspace:*"
  }
}
