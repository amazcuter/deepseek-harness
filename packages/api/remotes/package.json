{
  "name": "@metaworkflow/api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mwf": {
    "client": {
      "inject": [
        "@metaworkflow/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@metaworkflow/deque": "workspace:*",
    "@metaworkflow/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/scope": "workspace:*"
  },
  "devDependencies": {
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-preset-registry": "workspace:*",
    "@metaworkflow/api-gateway": "workspace:*",
    "@metaworkflow/api-job-controller": "workspace:*",
    "@metaworkflow/api-session-controller": "workspace:*",
    "@metaworkflow/api-settings-controller": "workspace:*",
    "@metaworkflow/api-workspace-controller": "workspace:*",
    "@metaworkflow/api-workspace-files": "workspace:*",
    "@metaworkflow/client-connection": "workspace:*",
    "@metaworkflow/client-file-upload": "workspace:*",
    "@metaworkflow/commands": "workspace:*",
    "@metaworkflow/cordis-host-runner": "workspace:*",
    "@metaworkflow/credentials": "workspace:*",
    "@metaworkflow/file-reference": "workspace:*",
    "@metaworkflow/goal": "workspace:*",
    "@metaworkflow/host-plugin-inventory": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/message-feedback": "workspace:*",
    "@metaworkflow/permission-presets": "workspace:*",
    "@metaworkflow/schedule": "workspace:*",
    "@metaworkflow/scope": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-reference": "workspace:*",
    "@metaworkflow/settings": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/typert-protocol": "workspace:*",
    "@metaworkflow/user-approval": "workspace:*",
    "@metaworkflow/user-questions": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "zod": "4.4.3",
    "@metaworkflow/command-feedback": "workspace:*",
    "@metaworkflow/api-terminal-controller": "workspace:*",
    "@metaworkflow/plugin-manager": "workspace:*",
    "@metaworkflow/plugin-market": "workspace:*",
    "@metaworkflow/client-ui-plugin-manager": "workspace:*",
    "@metaworkflow/office-to-pdf": "workspace:*",
    "@metaworkflow/api-account-controller": "workspace:*",
    "@metaworkflow/deepseek-account": "workspace:*",
    "@metaworkflow/client-product-analytics": "workspace:*"
  }
}
