{
  "name": "@metaworkflow/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "mwf": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-loop": "workspace:*",
    "@metaworkflow/attachment-local": "workspace:*",
    "@metaworkflow/compaction-basic": "workspace:*",
    "@metaworkflow/compaction-image-offload": "workspace:*",
    "@metaworkflow/deepseek-llm-api-extensions": "workspace:*",
    "@metaworkflow/jobs-local": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/llm-deepseek-api-key": "workspace:*",
    "@metaworkflow/llm-retry": "workspace:*",
    "@metaworkflow/mcp-resources": "workspace:*",
    "@metaworkflow/plugin-package-inventory-deepseek": "workspace:*",
    "@metaworkflow/sandbox-local": "workspace:*",
    "@metaworkflow/sandbox-policy": "workspace:*",
    "@metaworkflow/sdk-app": "workspace:*",
    "@metaworkflow/sdk-jsonrpc-server": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-log-deepseek": "workspace:*",
    "@metaworkflow/session-persistence-jsonl": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/session-title": "workspace:*",
    "@metaworkflow/subprocess-local": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/terminal": "workspace:*",
    "@metaworkflow/terminal-bash": "workspace:*",
    "@metaworkflow/token-meter": "workspace:*",
    "@metaworkflow/tool-bash-persistent": "workspace:*",
    "@metaworkflow/tool-fs": "workspace:*",
    "@metaworkflow/tool-pwsh-persistent": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@metaworkflow/working-directory": "workspace:*",
    "@metaworkflow/tool-working-directory": "workspace:*",
    "@metaworkflow/fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
