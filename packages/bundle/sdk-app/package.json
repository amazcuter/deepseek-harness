{
  "name": "@metaworkflow/sdk-app",
  "description": "The mwf SDK profile bundle: stdio JSON-RPC serving and process lifecycle over mwf-base",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "mwf": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@metaworkflow/cmdline": "workspace:*",
    "@metaworkflow/sdk-jsonrpc-server": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "commander": "^15.0.0",
    "@metaworkflow/skill-office": "workspace:*",
    "@metaworkflow/tool-workspace-dependencies": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
