{
  "name": "@metaworkflow/subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child DeepSeek Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/sdk-client": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/subprocess": "workspace:*"
  },
  "dependencies": {
    "@metaworkflow/brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-instructions": "workspace:*",
    "@metaworkflow/app-boot": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/llm-deepseek": "workspace:*",
    "@metaworkflow/llm-deepseek-api-key": "workspace:*",
    "@metaworkflow/loader-smoke": "workspace:*",
    "@metaworkflow/sdk-client": "workspace:*",
    "@metaworkflow/sdk-protocol": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-checkpoint-policy": "workspace:*",
    "@metaworkflow/session-persistence-jsonl": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/skill-filesystem": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/subprocess": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/tool-subagent": "workspace:*"
  }
}
