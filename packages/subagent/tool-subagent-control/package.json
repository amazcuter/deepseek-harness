{
  "name": "@metaworkflow/tool-subagent-control",
  "description": "Globally named send_message, interrupt_agent, and list_agents tools over ctx.subagents continuations",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/tool-subagent-control"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./list-agents": {
      "types": "./lib/types/list-agents.d.ts",
      "default": "./lib/types/list-agents.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./list-agents/locale/*.json": "./locale/list-agents/*.json"
  },
  "files": [
    "locale/*.json",
    "locale/list-agents/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/tools": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-loop": "workspace:*",
    "@metaworkflow/agent-loop-testkit": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-persistence": "workspace:*",
    "@metaworkflow/session-persistence-jsonl": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/session-query": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/subagent-fork-in-process": "workspace:*",
    "@metaworkflow/subagent-spawn-in-process": "workspace:*",
    "@metaworkflow/tools": "workspace:*"
  },
  "dependencies": {
    "@metaworkflow/brand": "workspace:*",
    "@metaworkflow/util-values": "workspace:*"
  }
}
