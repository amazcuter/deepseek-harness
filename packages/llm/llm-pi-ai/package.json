{
  "name": "@metaworkflow/llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the DeepSeek Harness LLM seam (design-verification twin of mwf-llm-deepseek)",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/authorization": "workspace:*",
    "@metaworkflow/credentials": "workspace:*",
    "@metaworkflow/fs": "workspace:*",
    "@metaworkflow/launch-environment": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/timeout": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~"
  },
  "dependencies": {
    "@metaworkflow/brand": "workspace:*",
    "@metaworkflow/util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/authorization": "workspace:*",
    "@metaworkflow/credentials": "workspace:*",
    "@metaworkflow/fs": "workspace:*",
    "@metaworkflow/launch-environment": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/llm-deepseek": "workspace:*",
    "@metaworkflow/llm-deepseek-api-key": "workspace:*",
    "@metaworkflow/timeout": "workspace:*",
    "@metaworkflow/http-proxy": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@metaworkflow/settings": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    }
  }
}
