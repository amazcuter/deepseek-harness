{
  "name": "@metaworkflow/experimental-agent-team",
  "description": "Implicit-root Agent Teams roster, direct peer messaging, and shared task DAG",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@metaworkflow/brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-persistence": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/subagent": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-loop": "workspace:*",
    "@metaworkflow/agent-loop-testkit": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-persistence": "workspace:*",
    "@metaworkflow/session-persistence-jsonl": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/session-query": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/subagent-fork-in-process": "workspace:*",
    "@metaworkflow/subagent-spawn-in-process": "workspace:*"
  }
}
