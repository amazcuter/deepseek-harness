{
  "name": "@metaworkflow/experimental-auto-review",
  "description": "Per-tool LLM authorization review for the DeepSeek Harness Auto permission preset",
  "version": "0.2.1-rc.2",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-instructions": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/permission-presets": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/working-directory": "workspace:*"
  },
  "dependencies": {
    "@metaworkflow/util-values": "workspace:*"
  },
  "devDependencies": {
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-instructions": "workspace:*",
    "@metaworkflow/agent-loop": "workspace:*",
    "@metaworkflow/agent-loop-testkit": "workspace:*",
    "@metaworkflow/bash-sandbox": "workspace:*",
    "@metaworkflow/compaction": "workspace:*",
    "@metaworkflow/fs-local": "workspace:*",
    "@metaworkflow/fs-observation-policy": "workspace:*",
    "@metaworkflow/fs-sandbox": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/llm-deepseek": "workspace:*",
    "@metaworkflow/llm-deepseek-api-key": "workspace:*",
    "@metaworkflow/permission-presets": "workspace:*",
    "@metaworkflow/ptc-runtime-node": "workspace:*",
    "@metaworkflow/sandbox": "workspace:*",
    "@metaworkflow/sandbox-policy": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/shell": "workspace:*",
    "@metaworkflow/shell-env": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/subprocess-local": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/tool-bash": "workspace:*",
    "@metaworkflow/tool-fs": "workspace:*",
    "@metaworkflow/tool-subagent": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@metaworkflow/user-approval": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "mwf": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
