{
  "name": "@metaworkflow/experimental-webworker-packer",
  "description": "Build-time packer for the browser runtime's base VFS image and ordered data-overlay archives",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/webworker-packer"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "mwf-pack-vfs-image": "./bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/bin.js",
    "bin.js",
    "lib/repository-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@metaworkflow/app-boot": "workspace:*",
    "@metaworkflow/experimental-webworker-runtime": "workspace:*",
    "@metaworkflow/session-format": "workspace:*",
    "@metaworkflow/session-format-catalog": "workspace:*",
    "@metaworkflow/session-format-v3-to-v4": "workspace:*",
    "js-yaml": "^4.3.2",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^4.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
