{
  "name": "@metaworkflow/experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "native/bin",
    "native/Package.swift",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/computer-use": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/subprocess": "workspace:*",
    "@metaworkflow/user-questions": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@metaworkflow/atomic-write": "workspace:*",
    "@metaworkflow/cua": "workspace:*"
  },
  "devDependencies": {
    "@metaworkflow/working-directory": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-loop": "workspace:*",
    "@metaworkflow/agent-loop-testkit": "workspace:*",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/attachment-local": "workspace:*",
    "@metaworkflow/computer-use": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@metaworkflow/subprocess": "workspace:*",
    "@metaworkflow/subprocess-local": "workspace:*",
    "@metaworkflow/fs-local": "workspace:*",
    "@metaworkflow/llm-deepseek": "workspace:*",
    "@metaworkflow/ptc-runtime-node": "workspace:*",
    "@metaworkflow/sandbox-local": "workspace:*",
    "@metaworkflow/sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@metaworkflow/ptc-runtime": "workspace:*",
    "@metaworkflow/user-questions": "workspace:*",
    "@metaworkflow/settings": "workspace:*",
    "@metaworkflow/app-boot": "workspace:*",
    "@metaworkflow/config-editor": "workspace:*",
    "@metaworkflow/hmr": "workspace:*",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~"
  },
  "scripts": {
    "build:native": "swift build --package-path native --configuration release"
  }
}
