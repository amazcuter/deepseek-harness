{
  "name": "@metaworkflow/experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on DeepSeek Harness extension points",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@metaworkflow/util-crypto": "workspace:*",
    "@metaworkflow/util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/commands": "workspace:*",
    "@metaworkflow/fs": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/scope": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/storage-domain": "workspace:*",
    "@metaworkflow/subprocess": "workspace:*",
    "@metaworkflow/token-meter": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@metaworkflow/typert-protocol": "workspace:*",
    "@metaworkflow/user-questions": "workspace:*",
    "@metaworkflow/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-loop": "workspace:*",
    "@metaworkflow/agent-loop-testkit": "workspace:*",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/commands": "workspace:*",
    "@metaworkflow/fs": "workspace:*",
    "@metaworkflow/fs-local": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/scope": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/storage": "workspace:*",
    "@metaworkflow/storage-domain": "workspace:*",
    "@metaworkflow/storage-json": "workspace:*",
    "@metaworkflow/subprocess": "workspace:*",
    "@metaworkflow/subprocess-local": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/token-meter": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@metaworkflow/typert-protocol": "workspace:*",
    "@metaworkflow/user-questions": "workspace:*",
    "@metaworkflow/working-directory": "workspace:*",
    "@metaworkflow/session-persistence-jsonl": "workspace:*"
  }
