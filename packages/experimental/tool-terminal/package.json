{
  "name": "@metaworkflow/tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/terminal": "workspace:*",
    "@metaworkflow/output-retention": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/jobs": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-loop-testkit": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/terminal": "workspace:*",
    "@metaworkflow/terminal-bash": "workspace:*",
    "@metaworkflow/output-retention": "workspace:*",
    "@metaworkflow/sandbox": "workspace:*",
    "@metaworkflow/sandbox-policy": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/subprocess-local": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*",
    "@metaworkflow/jobs": "workspace:*",
    "@metaworkflow/jobs-local": "workspace:*",
    "@metaworkflow/tool-jobs": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/working-directory": "workspace:*"
  }
