{
  "name": "@metaworkflow/spill-policy",
  "description": "Token-budgeted tool-result retention with recoverable text and image paths",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/output-retention": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/spill": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/fs": "workspace:*",
    "@metaworkflow/token-meter": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/ptc-runtime-node": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/output-retention": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/spill": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/fs-local": "workspace:*",
    "@metaworkflow/subprocess-local": "workspace:*",
    "@metaworkflow/sandbox-local": "workspace:*",
    "@metaworkflow/sandbox-policy": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/fs": "workspace:*",
    "@metaworkflow/token-meter": "workspace:*",
    "@metaworkflow/mcp-client": "workspace:*",
    "@metaworkflow/spill-local": "workspace:*",
    "@metaworkflow/llm-deepseek": "workspace:*",
    "@metaworkflow/ptc-runtime": "workspace:*",
    "@metaworkflow/attachment-local": "workspace:*",
    "@metaworkflow/tool-fs": "workspace:*",
    "sharp": "0.35.5",
    "@metaworkflow/agent-loop-testkit": "workspace:*"
  }
}
