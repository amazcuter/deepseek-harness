{
  "name": "@metaworkflow/mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/mcp/mcp-client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/scope": "workspace:*",
    "@metaworkflow/subprocess": "workspace:*",
    "@metaworkflow/timeout": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/mcp-resources": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@modelcontextprotocol/client": "2.2.0",
    "@metaworkflow/util-values": "workspace:*"
  },
  "devDependencies": {
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/attachment-local": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/scope": "workspace:*",
    "@metaworkflow/subprocess": "workspace:*",
    "@metaworkflow/timeout": "workspace:*",
    "@metaworkflow/tools": "workspace:*",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/http-proxy": "workspace:*",
    "@modelcontextprotocol/server": "2.2.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "4.4.3",
    "@metaworkflow/mcp-resources": "workspace:*",
    "@metaworkflow/system-prompt": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@metaworkflow/mcp-resources": {
      "optional": true
    },
    "@metaworkflow/system-prompt": {
      "optional": true
    }
  }
}
