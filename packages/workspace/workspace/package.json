{
  "name": "@metaworkflow/workspace",
  "description": "Workspace registry (ctx.workspaceRegistry): workflow projects as session groups \u2014 ordered session accounts, display order, first-use identity, and the archive and pin sets over ctx.mwfProjectStore",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/workspace/workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-persistence": "workspace:*",
    "@metaworkflow/storage": "workspace:*",
    "@metaworkflow/storage-domain": "workspace:*",
    "@metaworkflow/typert-protocol": "workspace:*",
    "@metaworkflow/workflow-project-store": "workspace:*"
  },
  "dependencies": {
    "@metaworkflow/brand": "workspace:*",
    "zod": "4.4.3",
    "@metaworkflow/workflow-project-store": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-persistence": "workspace:*",
    "@metaworkflow/storage": "workspace:*",
    "@metaworkflow/storage-domain": "workspace:*",
    "@metaworkflow/typert-protocol": "workspace:*",
    "@metaworkflow/workflow-project-store": "workspace:*"
  }
}
