{
  "name": "@metaworkflow/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process DeepSeek Harness SDK clients",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@metaworkflow/brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/llm-deepseek-api-key": "workspace:*",
    "@metaworkflow/scope": "workspace:*",
    "@metaworkflow/sdk-protocol": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-loop": "workspace:*",
    "@metaworkflow/agent-loop-testkit": "workspace:*",
    "@metaworkflow/attachment": "workspace:*",
    "@metaworkflow/llm": "workspace:*",
    "@metaworkflow/llm-deepseek-api-key": "workspace:*",
    "@metaworkflow/scope": "workspace:*",
    "@metaworkflow/sdk-protocol": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/session-persistence-jsonl": "workspace:*",
    "@metaworkflow/session-projection": "workspace:*",
    "@metaworkflow/subagent": "workspace:*",
    "@metaworkflow/working-directory": "workspace:*"
  }
}
