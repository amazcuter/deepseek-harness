{
  "name": "@metaworkflow/workflow-project-store",
  "description": "Workflow project persistence (ctx.mwfProjectStore): the global project registry and one SQLite database per project for definitions, runs, activations, attempts, artifacts, decisions, and the session outbox",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/workflow/project-store"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/home-paths": "workspace:*",
    "@metaworkflow/util-values": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@metaworkflow/brand": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/home-paths": "workspace:*",
    "@metaworkflow/util-values": "workspace:*"
  }
}
