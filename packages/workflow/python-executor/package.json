{
  "name": "@metaworkflow/workflow-python-executor",
  "description": "Host-side python node executor for the workflow scheduler (ctx.mwfPythonExecutor): registers the `python` node kind, reads each run's stored definition revision, runs the node through ctx.mwfPythonRunner in the project working directory, and reports one structured outcome",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/workflow/python-executor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/brand": "workspace:*",
    "@metaworkflow/util-values": "workspace:*",
    "@metaworkflow/workflow-definition": "workspace:*",
    "@metaworkflow/workflow-project-store": "workspace:*",
    "@metaworkflow/workflow-python-runner": "workspace:*",
    "@metaworkflow/workflow-scheduler": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@metaworkflow/brand": "workspace:*",
    "@metaworkflow/util-values": "workspace:*",
    "@metaworkflow/workflow-definition": "workspace:*",
    "@metaworkflow/workflow-project-store": "workspace:*",
    "@metaworkflow/workflow-python-runner": "workspace:*",
    "@metaworkflow/workflow-scheduler": "workspace:*"
  }
}
