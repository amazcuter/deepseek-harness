{
  "name": "@metaworkflow/jobs-local",
  "description": "Process-local implementation of the DeepSeek Harness background job registry seam",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/scope": "workspace:*",
    "@metaworkflow/jobs": "workspace:*",
    "@metaworkflow/timeout": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@metaworkflow/agent": "workspace:*",
    "@metaworkflow/agent-loop-testkit": "workspace:*",
    "@metaworkflow/brand": "workspace:*",
    "@metaworkflow/scope": "workspace:*",
    "@metaworkflow/session": "workspace:*",
    "@metaworkflow/jobs": "workspace:*",
    "@metaworkflow/timeout": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
